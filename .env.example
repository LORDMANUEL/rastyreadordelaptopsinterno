POSTGRES_DB=yude_asset_guard
POSTGRES_USER=yude_asset_guard
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+psycopg://yude_asset_guard:CHANGE_ME@db:5432/yude_asset_guard

# Enrollment codes are the production default.
ALLOW_LEGACY_ENROLLMENT_TOKEN=false
# Optional compatibility bootstrap only when legacy mode is explicitly enabled.
ENROLLMENT_TOKEN=

# API/automation compatibility token. Do not expose it in the browser UI.
ADMIN_TOKEN=CHANGE_ME_LONG_RANDOM_VALUE

# Web sessions for database-backed RBAC accounts.
SESSION_SECRET=CHANGE_ME_LONG_RANDOM_VALUE
SESSION_TTL_SECONDS=28800

HEARTBEAT_OFFLINE_SECONDS=600
DEVICE_AUTH_ROTATE_DAYS=7
DEVICE_AUTH_TTL_DAYS=45

# Approximate network geolocation from a local MMDB database.
NETWORK_GEO_REQUIRED=false
GEOIP_CITY_DB=/geoip/GeoLite2-City.mmdb


# HTTP hardening
FORWARDED_ALLOW_IPS=127.0.0.1
MAX_REQUEST_BYTES=2097152
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=60
ENROLL_RATE_LIMIT=30
ENROLL_RATE_WINDOW_SECONDS=300


# Publicación local del API. Mantenga 127.0.0.1 cuando use reverse proxy en el mismo host.
API_BIND_ADDRESS=127.0.0.1
API_PORT=8000
