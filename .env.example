POSTGRES_DB=yude_asset_guard
POSTGRES_USER=yude_asset_guard
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+psycopg://yude_asset_guard:CHANGE_ME@db:5432/yude_asset_guard

ENROLLMENT_TOKEN=CHANGE_ME_LONG_RANDOM_VALUE

# API/automation compatibility token. Do not expose it in the browser UI.
ADMIN_TOKEN=CHANGE_ME_LONG_RANDOM_VALUE

# Web administrator login. Generate salt/hash with:
# python -m app.hash_password
ADMIN_USERNAME=admin
ADMIN_PASSWORD_SALT=CHANGE_ME_HEX_SALT
ADMIN_PASSWORD_HASH=CHANGE_ME_SCRYPT_HASH
SESSION_SECRET=CHANGE_ME_LONG_RANDOM_VALUE
SESSION_TTL_SECONDS=28800

HEARTBEAT_OFFLINE_SECONDS=600
